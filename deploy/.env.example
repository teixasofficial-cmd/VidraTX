# Configuração de produção. Crie o .env com ./scripts/configurar.sh (gera
# as senhas) ou copie este arquivo para .env e preencha à mão.
# O .env tem segredos: nunca vai para o git.

# Domínio do painel (o registro DNS tipo A precisa apontar para o servidor)
# e e-mail para os avisos do Let's Encrypt sobre o certificado.
DOMINIO=painel.exemplo.com.br
EMAIL_ACME=voce@exemplo.com.br

# Senhas e segredos: longos e aleatórios (openssl rand -hex 32).
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
JWT_SECRET=
WHATSAPP_GATEWAY_TOKEN=

# Fuso das datas quando a empresa não configurou o dela.
VIDRATX_FUSO_HORARIO=America/Sao_Paulo

# Alerta de WhatsApp desconectado (opcional): URL de webhook do Slack,
# Discord ou Google Chat. Sem ela, o alerta fica só no log do backend.
ALERTA_WEBHOOK_URL=
ALERTA_WHATSAPP_DESCONECTADO_MINUTOS=30

# Backup diário do banco e das fotos em deploy/backups: hora (0-23) e por
# quantos dias guardar.
BACKUP_HORA=3
BACKUP_RETENCAO_DIAS=14
