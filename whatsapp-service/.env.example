# Porta HTTP deste serviço
PORT=3333

# Segredo compartilhado com o backend Spring (mesmo valor de
# WHATSAPP_GATEWAY_TOKEN no application.properties). Só o Spring pode
# chamar as rotas deste serviço, e é este token que garante isso.
GATEWAY_TOKEN=

# URL base do backend Spring, para onde as mensagens recebidas e os
# eventos de conexão são enviados.
SPRING_BASE_URL=http://localhost:8080

# Diretório onde as credenciais de cada sessão do WhatsApp ficam salvas
# (uma subpasta por instanciaToken). Nunca commitar este diretório.
AUTH_STATE_DIR=auth_sessions

# Fila em disco das mensagens de clientes que o backend não aceitou (fora
# do ar). São reenviadas a cada 15 s até entrar. Nunca commitar.
FILA_DIR=fila_webhook

# Tempo máximo (ms) para consultar a versão mais recente do WhatsApp Web
# na subida. Sem resposta, a sessão usa a versão embutida no Baileys.
TIMEOUT_VERSAO_MS=5000

# Mensagens que o cliente mandou com este serviço fora do ar chegam na
# reconexão; repassadas ao backend se forem das últimas N horas.
JANELA_MENSAGENS_OFFLINE_HORAS=72

# Registro dos envios por chave de idempotência (sobrevive a reinícios:
# a mesma mensagem nunca sai duas vezes para o cliente).
ARQUIVO_IDEMPOTENCIA=envios-idempotencia.json
